# MiniCode-go CLI 配置模板
#
# 用法:
#   cp .env.example .env          # 复制为 .env,然后填入真实值
#   source .env                   # bash 加载
#   export $(grep -v '^#' .env | xargs)   # 一行加载
#
# 命令行 flag(-api-key / -base-url / -model)优先级高于本文件的值。
# .env 不应提交到 git。

# 模型服务 API Key(必填)
MINICODE_API_KEY=

# 模型服务 Base URL,要求 OpenAI 兼容 /chat/completions 端点(必填)
# 常用值:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Moonshot:  https://api.moonshot.cn/v1
#   智谱:       https://open.bigmodel.cn/api/paas/v4
MINICODE_BASE_URL=

# 模型名(必填),与 BaseURL 对应:
#   OpenAI:    gpt-4o-mini / gpt-4o
#   DeepSeek:  deepseek-chat
#   Moonshot:  moonshot-v1-8k
#   智谱:       glm-4-flash
MINICODE_MODEL=
